// Prisma Schema for AI Mentor - Interview Preparation App
// Optimized for SQLite / PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  password       String
  name           String
  targetRole     String?            @default("Full Stack Developer")
  readinessScore Int?               @default(65)
  skills         String?            @default("React, TypeScript, Node.js, SQL")
  avatarUrl      String?
  isVerified     Boolean            @default(true)
  otpCode        String?
  otpExpiresAt   DateTime?
  bio            String?
  phone          String?
  experienceLevel String?           @default("Junior")
  education      String?
  githubUrl      String?
  linkedinUrl    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  interviews     InterviewSession[]
  submissions          CodingSubmission[]
  resumes              ResumeDiagnostic[]
  chatMessages         ChatMessage[]
  technicalAssessments TechnicalAssessment[]
  certificates         Certificate[]
  jobApplications      JobApplication[]
}

model InterviewSession {
  id           String              @id @default(uuid())
  userId       String
  type         String              // BEHAVIORAL, TECHNICAL, SYSTEM_DESIGN
  role         String              @default("Software Engineer")
  difficulty   String              @default("Medium")
  overallScore Int?
  feedback     String?
  status       String              @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions    InterviewQuestion[]
}

model InterviewQuestion {
  id           String           @id @default(uuid())
  sessionId    String
  questionText String
  category     String           @default("General")
  difficulty   String           @default("Medium")
  userAnswer   String?
  aiFeedback   String?
  score        Int?
  audioUrl     String?
  createdAt    DateTime         @default(now())

  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model CodingChallenge {
  id             String             @id @default(uuid())
  title          String
  slug           String             @unique
  category       String             // Algorithms, Data Structures, Database, System
  difficulty     String             // Easy, Medium, Hard
  description    String
  starterCode    String
  functionName   String?            @default("solution")
  role           String?            @default("Software Engineer") // Software Engineer, DevOps, QA Engineer, All
  level          String?            @default("Junior")           // Internship, Junior, Senior, All
  testCases      String             // JSON string of inputs and expected outputs
  hints          String?            // JSON string array
  optimalCode    String?
  timeComplexity String?
  spaceComplexity String?
  acceptanceRate String             @default("72%")
  createdAt      DateTime           @default(now())

  submissions    CodingSubmission[]
}

model TechnicalAssessment {
  id           String   @id @default(uuid())
  userId       String
  role         String   @default("Software Engineer")
  difficulty   String   @default("Mixed")
  status       String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  totalScore   Int      @default(0)
  passed       Boolean  @default(false)
  feedback     String?  // JSON AI evaluation report
  questionIds  String   // JSON array of 5 CodingChallenge IDs
  userAnswers  String?  // JSON record of user answers and per-question test results
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CodingSubmission {
  id          String          @id @default(uuid())
  userId      String
  challengeId String
  code        String
  language    String          @default("typescript")
  status      String          // ACCEPTED, WRONG_ANSWER, RUNTIME_ERROR
  score       Int             @default(0)
  output      String?
  createdAt   DateTime        @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   CodingChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model ResumeDiagnostic {
  id              String   @id @default(uuid())
  userId          String
  fileName        String
  fileSize        Int?
  overallScore    Int      @default(0)
  atsScore        Int      @default(0)
  formattingScore Int      @default(0)
  impactScore     Int      @default(0)
  extractedText   String?
  suggestions     String   // JSON string array
  missingKeywords String   // JSON string array
  strengths       String?  // JSON string array
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  sender    String   // USER, AI
  message   String
  context   String?  // INTERVIEW_PREP, RESUME, GENERAL
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────
// ENTERPRISE CERTIFICATE SYSTEM
// ─────────────────────────────────────────────────────────

model Certificate {
  id            String   @id @default(uuid())
  userId        String
  credentialId  String   @unique
  candidateName String
  targetRole    String
  score         String   @default("100% MASTERY")
  pdfUrl        String
  issueDate     DateTime @default(now())
  status        String   @default("ACTIVE") // ACTIVE, REVOKED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────
// COMPANY / RECRUITER PORTAL
// ─────────────────────────────────────────────────────────

model Company {
  id          String       @id @default(uuid())
  name        String
  email       String       @unique
  password    String
  logoUrl     String?
  website     String?
  industry    String?      @default("Technology")
  description String?
  size        String?      @default("50-200") // 1-10, 10-50, 50-200, 200-1000, 1000+
  location    String?
  isVerified  Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  jobPostings JobPosting[]
}

model JobPosting {
  id           String    @id @default(uuid())
  companyId    String
  title        String
  description  String
  targetRole   String    @default("Software Engineer")
  location     String?   @default("Remote")
  salaryRange  String?
  requirements String?   // JSON array of required skills
  type         String    @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERNSHIP
  experience   String?   @default("Junior") // Internship, Junior, Mid-Level, Senior, Lead
  status       String    @default("ACTIVE") // ACTIVE, CLOSED, DRAFT
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications JobApplication[]
}

model JobApplication {
  id             String      @id @default(uuid())
  jobId          String
  userId         String
  fullName       String
  email          String
  phone          String?
  resumeUrl      String?     // PDF download URL or path
  coverLetter    String?
  readinessScore Int?        @default(0)
  hasCertificate Boolean     @default(false)
  status         String      @default("PENDING") // PENDING, REVIEWING, SHORTLISTED, REJECTED, ACCEPTED
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  job            JobPosting  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([userId])
}
